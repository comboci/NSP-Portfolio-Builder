  "design_observations_fa": [
    "طراحی افقی با پس‌زمینه سفید، تیتر بولد تیره، یک خط قرمز کوتاه و عکس کاربردی؛ هویت بصری NSP باید مستقل تعیین شود.",
    "صفحه ۲ عملکردهای پنل را با خطوط راهنما به نقاط صفحه متصل می‌کند؛ مقایسه فینیش‌ها در سواچ‌های منظم زیر آن آمده است.",
    "صفحه ۳ ارزش نرم‌افزار مدیریت اتاق را با تصویر بزرگ استفاده واقعی ترکیب می‌کند و حالت‌های اتاق را با هفت آیکون جداگانه نشان می‌دهد.",
    "صفحه ۴ سه سیستم کنترل دسترسی، اتوماسیون اتاق و PMS را در یک دیاگرام ساده کنار هم قرار می‌دهد؛ نام سامانه‌ها و سازگاری ABB نباید به NSP منتقل شود.",
    "صفحه ۵ عکس استفاده همزمان تلفن و تلویزیون را برای روایت تجربه دیجیتال مهمان به کار می‌گیرد؛ ناحیه‌های حاوی QR از نمونه پژوهشی حذف شده‌اند.",
    "صفحه ۶ نمودار سلسله‌مراتبی شبکه/اتاق‌ها را با رنگ قرمز برای نمایش مسیر حمله یا دسترسی غیرمجاز متمایز می‌کند؛ هیچ ادعای گواهی امنیتی NSP از آن نتیجه نمی‌شود.",
    "صفحه ۷ ترکیب پلان سه‌بعدی اتاق و روند ساده حضور/عدم حضور، الگویی برای توضیح سناریو به‌جای متن صرف است؛ تایمر ۱۰ دقیقه‌ای مخصوص ABB است.",
    "صفحه ۸ یک شبکه چندخانواده‌ای با تصویر و سواچ رنگ برای ارائه سبک تجهیزات است؛ کد مدل و مشخصات سخت‌افزاری رقیب از پژوهش فیچر حذف شده‌اند.",
    "صفحه ۹ از ترکیب تصویر و تیتر آینده‌نگر در صفحه جمع‌بندی بهره می‌گیرد؛ مفهوم آینده‌نگر به‌خودی‌خود قابلیت فعلی NSP را اثبات نمی‌کند.",
    "گرافیک‌های آیکون، خط قرمز، عکس‌های رقیب و تمپلیت نباید مستقیماً در صفحات تجاری NSP استفاده شوند."
  ],
  "restrictions_fa": [
    "این برش‌ها نسخه کم‌حجم مرجع طراحی هستند؛ حق استفاده تجاری از تصاویر یا لوگوهای ABB به NSP منتقل نشده است.",
    "هیچ یک از اطلاعات ورود به دمو یا محتوای QR در فایل‌های استخراج‌شده وجود ندارد.",
    "فایل S04 فقط پژوهش بصری است و به‌معنی تأیید قابلیت‌های نرم‌افزار، سناریوها، امنیت، PMS یا استانداردهای NSP نیست.",
    "تصمیم نهایی درباره سکشن و شماره صفحه در S05 بررسی می‌شود؛ آنچه در هر رکورد آمده صرفاً نامزدهای پیشنهادی است."
  ],
